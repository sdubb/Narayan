# ─────────────────────────────────────────────────────────
# Narayan Platform — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────

# ── Database (required) ───────────────────────────────────
NARAYAN__DATABASE__URL=postgres://user:password@localhost:5432/narayan
NARAYAN__DATABASE__MAX_CONNECTIONS=20

# ── Redis queue (optional — falls back to in-memory) ──────
NARAYAN__REDIS__URL=redis://localhost:6379
NARAYAN__REDIS__ENABLED=true

# ── Security (required — change before first deploy) ──────
# JWT_SECRET: any long random string (256-bit recommended)
# ENCRYPT_KEY: exactly 32 bytes used to encrypt tenant API keys at rest
NARAYAN_JWT_SECRET=replace-this-with-a-long-random-secret
NARAYAN_ENCRYPT_KEY=replace-this-32-byte-key-now!!!!

# ── Worker configuration ───────────────────────────────────
NARAYAN__WORKER__POOL_SIZE=32
NARAYAN__SCHEDULER__POLL_INTERVAL_MS=500
NARAYAN__SCHEDULER__MAX_BATCH_SIZE=256

# ── LLM Gateway ───────────────────────────────────────────
# Cache: how long to reuse identical LLM responses (seconds)
NARAYAN__GATEWAY__CACHE_TTL_SECS=300
# Rate limit: max requests/sec per provider across all tenants
NARAYAN__GATEWAY__REQUESTS_PER_SEC=10.0

# ── Server ────────────────────────────────────────────────
NARAYAN__SERVER__HOST=0.0.0.0
NARAYAN__SERVER__PORT=8080

# ── Workspace ─────────────────────────────────────────────
NARAYAN_WORKSPACE=./workspace

# ─────────────────────────────────────────────────────────
# BYOK — Bring Your Own Key
#
# Narayan does NOT use platform-level LLM API keys.
# Every user/tenant registers their own credentials via:
#
#   PUT /credentials
#   {
#     "provider": "anthropic",
#     "api_key":  "sk-ant-...",
#     "model":    "claude-sonnet-4-6",
#     "label":    "My Anthropic Key"
#   }
#
# Supported providers: anthropic, openai, ollama, gemini,
#   openrouter, openai_codex, glm, novita, sglang
#
# Keys are encrypted at rest using NARAYAN_ENCRYPT_KEY.
#
# For local development only, you may add a platform fallback:
#   ANTHROPIC_API_KEY=sk-ant-...   (optional dev shortcut)
# ─────────────────────────────────────────────────────────

# ── Workspace (Hybrid Storage) ────────────────────────────────────────────
# mode: "local" | "remote" | "hybrid" (default: hybrid)
# hybrid = prefer local SSD, switch to remote when disk > threshold
NARAYAN__WORKSPACE__LOCAL_ROOT=/var/narayan/workspaces
NARAYAN__WORKSPACE__MODE=hybrid
NARAYAN__WORKSPACE__DISK_THRESHOLD_PCT=80
NARAYAN__WORKSPACE__CLEANUP_AFTER_HOURS=24

# Object storage (S3 / Cloudflare R2 / MinIO)
# Leave blank to disable remote storage (local-only mode)
NARAYAN__WORKSPACE__S3_BUCKET=narayan-workspaces
NARAYAN__WORKSPACE__S3_ENDPOINT=https://s3.amazonaws.com
# For Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# For MinIO:         http://minio:9000
NARAYAN__WORKSPACE__S3_REGION=us-east-1
NARAYAN__WORKSPACE__S3_ACCESS_KEY=your-access-key
NARAYAN__WORKSPACE__S3_SECRET_KEY=your-secret-key

# ── Semantic Memory (pgvector) ────────────────────────────────────────────
# Requires: CREATE EXTENSION IF NOT EXISTS vector; in your Postgres DB
# Provider: openai | anthropic (voyage) | ollama | stub (default, no embedding)
NARAYAN_EMBED_PROVIDER=openai
NARAYAN_EMBED_API_KEY=sk-...
# Optional: override the model
# NARAYAN_EMBED_MODEL=text-embedding-3-large   # openai large (3072 dims)
# NARAYAN_EMBED_MODEL=voyage-code-3             # anthropic code-optimised
# NARAYAN_EMBED_MODEL=nomic-embed-text          # ollama local (base_url as api_key)
