# ============================================================
# Narayan — complete .env
# Copy to project root as .env before running `cargo run`
# All NARAYAN__ prefix vars map to AppConfig via config crate
# ============================================================


# ── REQUIRED — server will not start without these ──────────

# JWT signing secret — generate with: openssl rand -hex 64
NARAYAN_JWT_SECRET=replace_with_64_hex_chars

# AES-256-GCM key for encrypting stored credentials (connector tokens, API keys)
# Generate with: openssl rand -hex 32  (must be exactly 32 bytes / 64 hex chars)
NARAYAN_ENCRYPT_KEY=replace_with_64_hex_chars


# ── DATABASE ─────────────────────────────────────────────────

# PostgreSQL connection string — must have pgvector extension installed
# CREATE EXTENSION vector;  ← run once after creating the DB
NARAYAN__DATABASE__URL=postgres://narayan:password@localhost:5432/narayan

# Connection pool size (default: 20)
NARAYAN__DATABASE__MAX_CONNECTIONS=20


# ── REDIS (optional but recommended) ────────────────────────

# Used for task queue, rate limiting, pub/sub
NARAYAN__REDIS__URL=redis://localhost:6379
NARAYAN__REDIS__ENABLED=false


# ── SERVER ───────────────────────────────────────────────────

NARAYAN__SERVER__HOST=0.0.0.0
NARAYAN__SERVER__PORT=8080


# ── WORKER / SCHEDULER ──────────────────────────────────────

# Number of parallel agent workers (increase for higher throughput)
NARAYAN__WORKER__POOL_SIZE=32

# How often the scheduler polls for new tasks in milliseconds
NARAYAN__SCHEDULER__POLL_INTERVAL_MS=500

# Max tasks to pick up per poll cycle
NARAYAN__SCHEDULER__MAX_BATCH_SIZE=256


# ── LLM GATEWAY ─────────────────────────────────────────────

# Response cache TTL in seconds
NARAYAN__GATEWAY__CACHE_TTL_SECS=300

# Max cached responses in memory
NARAYAN__GATEWAY__CACHE_MAX_ENTRIES=10000

# Global LLM requests per second across all tenants (gateway rate limiter)
NARAYAN__GATEWAY__REQUESTS_PER_SEC=10.0

# NOTE: LLM provider API keys are stored per-tenant in the database (BYOK model).
# Tenants add their own keys via PUT /credentials in the UI.
# There is no platform-level fallback key in production — each tenant must
# configure at least one provider before running agents.
#
# For local development only, you can wire a fallback by modifying
# the fallback_providers HashMap in src/main.rs (not via env vars).
# Supported providers: anthropic, openai, groq, gemini, openrouter, azure_openai

# Plan mode end-to-end test harness (used by `cargo test -- --ignored`)
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile


# ── EMBEDDINGS ───────────────────────────────────────────────

# Provider for generating embeddings (used for vector memory / semantic search)
# Options: openai, anthropic, local
NARAYAN_EMBED_PROVIDER=openai

# API key for the embedding provider
NARAYAN_EMBED_API_KEY=sk-...

# Override the embedding model (optional — uses provider default if unset)
# openai default: text-embedding-3-small
# NARAYAN_EMBED_MODEL=text-embedding-3-small


# ── WORKSPACE ────────────────────────────────────────────────

# Root directory for agent workspaces on local disk
NARAYAN__WORKSPACE__LOCAL_ROOT=./workspaces

# Storage mode: "local" | "remote" | "hybrid"
# local  — all workspace files stay on disk
# remote — all workspace files go to S3-compatible storage
# hybrid — local until disk_threshold_pct, then spills to remote
NARAYAN__WORKSPACE__MODE=hybrid

# Disk usage percentage at which hybrid mode switches to remote (default: 80)
NARAYAN__WORKSPACE__DISK_THRESHOLD_PCT=80

# Clean up workspaces older than this many hours (default: 24)
NARAYAN__WORKSPACE__CLEANUP_AFTER_HOURS=24

# ── S3 / Object storage (required if MODE=remote or MODE=hybrid) ────────────
# Works with AWS S3, Cloudflare R2, MinIO, or any S3-compatible service

NARAYAN__WORKSPACE__S3_BUCKET=narayan-workspaces
NARAYAN__WORKSPACE__S3_REGION=us-east-1

# Leave blank for AWS (auto-resolves). Set for R2/MinIO:
# Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
# MinIO local:   http://localhost:9000
NARAYAN__WORKSPACE__S3_ENDPOINT=

NARAYAN__WORKSPACE__S3_ACCESS_KEY=your_access_key
NARAYAN__WORKSPACE__S3_SECRET_KEY=your_secret_key


# ── BROWSER / HEADLESS CHROME ────────────────────────────────

# Number of Chromium instances in the pool for web automation tools
# Set to 0 to disable all browser-based tools (web_fetch still works via HTTP)
NARAYAN_BROWSER_POOL_SIZE=2


# ── BILLING — STRIPE ─────────────────────────────────────────
# Only needed if you are using Stripe for subscription billing

# Stripe secret key (sk_live_... for production, sk_test_... for testing)
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret from the Stripe dashboard
# Webhooks → Add endpoint → signing secret
STRIPE_WEBHOOK_SECRET=whsec_...


# ── BILLING — PAYPAL ─────────────────────────────────────────
# Only needed if you are using PayPal for subscription billing

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Subscription plan IDs created in your PayPal dashboard
PAYPAL_PLAN_ID_GO=
PAYPAL_PLAN_ID_PRO=

# Set to true to use PayPal sandbox for testing
PAYPAL_SANDBOX=true


# ── OAUTH — BUILT-IN CONNECTORS ──────────────────────────────
# Each connector that uses OAuth2 needs a CLIENT_ID and CLIENT_SECRET.
# Create an OAuth app in each service's developer console.
# Redirect URL for all: https://yourdomain.com/oauth/callback/{connector_name}
#
# These are platform-level OAuth apps — all tenants share them.
# Tenant tokens are stored encrypted per-tenant in connector_installs table.

# Salesforce (OAuth2)
# console.salesforce.com → Setup → App Manager → New Connected App
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# HubSpot (OAuth2)
# developers.hubspot.com → Apps → Create App
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Zendesk (OAuth2)
# {subdomain}.zendesk.com → Admin → Apps → OAuth Clients
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=

# Intercom (OAuth2)
# developers.intercom.com → Your App → OAuth
INTERCOM_CLIENT_ID=
INTERCOM_CLIENT_SECRET=

# Freshdesk (API Key — not OAuth. Stored per-tenant at setup time)
# No platform-level keys needed for Freshdesk

# GitHub (OAuth2)
# github.com → Settings → Developer Settings → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Notion (OAuth2)
# developers.notion.com → New integration
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Slack (OAuth2)
# api.slack.com → Create New App → OAuth & Permissions
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Gmail / Google Workspace (OAuth2)
# console.cloud.google.com → APIs → Credentials → OAuth 2.0 Client
# Scopes needed: gmail.readonly, gmail.send, gmail.modify
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Outlook / Microsoft 365 (OAuth2)
# portal.azure.com → App registrations → New registration
# Scopes: Mail.ReadWrite, Mail.Send, Calendars.ReadWrite
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# QuickBooks (OAuth2)
# developer.intuit.com → Dashboard → Create an App
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# Stripe (OAuth2 for Connect — separate from billing keys above)
# dashboard.stripe.com → Settings → Connect
STRIPE_CONNECT_CLIENT_ID=
STRIPE_CONNECT_CLIENT_SECRET=

# ServiceNow (OAuth2)
# Instance → System OAuth → Application Registry
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=

# PagerDuty (OAuth2)
# developer.pagerduty.com → My Apps → Create New App
PAGERDUTY_CLIENT_ID=
PAGERDUTY_CLIENT_SECRET=

# Greenhouse (API Key — not OAuth. Stored per-tenant at setup time)
# No platform-level keys needed for Greenhouse

# DocuSign (OAuth2)
# admindemo.docusign.com → Apps and Keys → Add App
DOCUSIGN_CLIENT_ID=
DOCUSIGN_CLIENT_SECRET=

# dbt Cloud (API Token — not OAuth. Stored per-tenant at setup time)
# No platform-level keys needed for dbt Cloud

# Jira / Atlassian (OAuth2)
# developer.atlassian.com → Create → OAuth 2.0 integration
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Asana (OAuth2)
# developers.asana.com → My Apps → Create New App
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=


# ── RUST LOGGING ─────────────────────────────────────────────

# Log level: error | warn | info | debug | trace
RUST_LOG=narayan=info,tower_http=warn

# Set to 1 to show full backtraces on panics
RUST_BACKTRACE=0
